{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "start-chromium-debug",
      "type": "shell",
      "command": "chromium http://localhost:4200",
      "problemMatcher": []
    },
    {
      "label": "wait-for-chromium",
      "type": "shell",
      "command": "sleep 3",
      "problemMatcher": []
    },
    {
      "label": "attach-chromium-workflow",
      "dependsOrder": "sequence",
      "dependsOn": [
        "start-chromium-debug",
        "wait-for-chromium"
      ],
      "problemMatcher": []
    }
  ]
}
